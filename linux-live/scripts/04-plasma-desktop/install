#!/bin/bash
#
# KDE Plasma desktop module (X11 session).
#
# Modelled on 04-ukui-desktop/install.  The points worth knowing:
#   * The session is X11: plasma-workspace ships
#     /usr/share/xsessions/plasmax11.desktop (Exec=startplasma-x11) and
#     registers startplasma-x11 as the x-session-manager alternative, so the
#     unchanged nodm -> /etc/X11/Xsession path of the minimum edition works.
#     kwin-x11 registers kwin_x11 as x-window-manager.
#   * plasma-workspace hard-depends on kwin-wayland and also ships
#     wayland-sessions/plasma.desktop.  lightdm is pinned to plasmax11 below;
#     sddm is intentionally NOT used because minios-live-config's sddm
#     component writes Session=plasma.desktop (the Wayland one) into
#     /etc/sddm.conf at boot, and that file outranks sddm.conf.d drop-ins.
#   * minios-live-config's lightdm component writes 50-autologin.conf with
#     only autologin-user (it derives "plasma-x" from startplasma-x11 and finds
#     no such session), so the 60- drop-in here is what selects the session.
#   * Appearance defaults (Breeze Dark, Night Light) are system-wide files in
#     rootcopy-install/etc/xdg/{kdeglobals,kwinrc}; the panel launcher button
#     and its pinned favourites are set by patching the default panel layout
#     template below.  Nothing is pre-seeded into a user's ~/.config.

set -e          # exit on error
set -o pipefail # exit on pipeline error
set -u          # treat unset variable as error

. /minioslib
. /minios_build.conf

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

rm -rf /usr/share/backgrounds

# The x-cursor-theme alternative link lives at /usr/share/icons/default/
# index.theme and update-alternatives will not create the parent directory.
# breeze-cursor-theme (from 03-gui-base) installs into its own named
# directory, so make sure the target directory exists before any postinst
# tries to register a cursor alternative.
mkdir -p /usr/share/icons/default

if ! /condinapt -l "${SCRIPT_DIR}/packages.list" -c "${SCRIPT_DIR}/minios_build.conf" -m "${SCRIPT_DIR}/condinapt.map"; then
    echo "Failed to install packages."
    exit 1
fi

# ---------------------------------------------------------------------------
# Remove packaged distribution wallpapers while preserving MiniOS packages and
# rootcopy assets.  plasma-workspace drops the "Next" set and its variants
# into /usr/share/wallpapers.
# ---------------------------------------------------------------------------
for WALLPAPER_DIR in /usr/share/backgrounds /usr/share/wallpapers; do
    [ -d "$WALLPAPER_DIR" ] || continue

    while IFS= read -r -d '' WALLPAPER; do
        WALLPAPER_OWNER="$(dpkg-query -S "$WALLPAPER" 2>/dev/null || true)"
        [ -n "$WALLPAPER_OWNER" ] || continue

        case "$WALLPAPER_OWNER" in
        minios*) continue ;;
        esac

        rm -f -- "$WALLPAPER"
    done < <(
        find "$WALLPAPER_DIR" -mindepth 1 \
            \( -type f -o -type l \) -print0
    )
    # Drop directories left empty by the removal above.
    find "$WALLPAPER_DIR" -mindepth 1 -type d -empty -delete 2>/dev/null || true
done

# ---------------------------------------------------------------------------
# Display manager.
# ---------------------------------------------------------------------------
if [ "${PACKAGE_VARIANT}" = "minimum" ]; then
    # nodm autologins straight into /etc/X11/Xsession, which runs the skel
    # ~/.xsession (exec startplasma-x11) or, failing that, x-session-manager.
    cat <<'NODM' >/etc/default/nodm
# nodm configuration

# Set NODM_ENABLED to something different than 'false' to enable nodm
NODM_ENABLED=true

# User to autologin for
NODM_USER=live

# First vt to try when looking for free VTs
NODM_FIRST_VT=7

# X session
NODM_XSESSION=/etc/X11/Xsession

# Options for nodm itself
NODM_OPTIONS=

# Options for the X server.
NODM_X_OPTIONS='-nolisten tcp'

# If an X session will run for less than this time in seconds, nodm will wait an
# increasing bit of time before restarting the session.
NODM_MIN_SESSION_TIME=60

# Timeout (in seconds) to wait for X to be ready to accept connections.
NODM_X_TIMEOUT=300
NODM
else
    # 60- sorts after live-config's 50-autologin.conf, so these keys win.
    # Both user-session and autologin-session are set: the first is what a
    # user gets from the greeter, the second is what autologin uses.
    mkdir -p /etc/lightdm/lightdm.conf.d
    cat <<LIGHTDM >/etc/lightdm/lightdm.conf.d/60-minios-plasma.conf
[Seat:*]
greeter-session=lightdm-gtk-greeter
user-session=plasmax11
autologin-session=plasmax11
autologin-user=${LIVE_USERNAME}
autologin-user-timeout=0
LIGHTDM
fi

# ---------------------------------------------------------------------------
# Wallpaper.
#
# Plasma's default wallpaper is named by the Breeze look-and-feel package:
#   /usr/share/plasma/look-and-feel/org.kde.breeze.desktop/contents/defaults
#     [Wallpaper]
#     Image=Next
# where "Next" is a wallpaper package under /usr/share/wallpapers/<Name>/ with
# a metadata.json and contents/images/<WxH>.<ext>.  The MiniOS artwork is
# wrapped into such a package and the defaults are pointed at it.  This is a
# default, so it applies to every user without touching dconf/kconfig state.
# ---------------------------------------------------------------------------
MINIOS_WALLPAPER="$(find /usr/share/backgrounds -maxdepth 1 -type f \
    \( -name 'minios*-standard.*' -o -name 'minios*-minimum.*' \
       -o -name 'minios*-toolbox.*' -o -name 'minios*-ultra.*' \) 2>/dev/null |
    sort | head -1)"

if [ -n "${MINIOS_WALLPAPER}" ]; then
    PKG_DIR=/usr/share/wallpapers/MiniOS
    mkdir -p "${PKG_DIR}/contents/images"

    # Plasma picks the image whose name is closest to the screen resolution.
    # `file` reports "..., 3840x2160, ..." for JPEG and "..., 3840 x 2160, ..."
    # for PNG; fall back to a generic name when it cannot be parsed.
    GEOMETRY="$(file -b "${MINIOS_WALLPAPER}" | grep -oE '[0-9]{3,5} ?x ?[0-9]{3,5}' | head -1 | tr -d ' ')"
    [ -n "${GEOMETRY}" ] || GEOMETRY="3840x2160"
    EXT="${MINIOS_WALLPAPER##*.}"
    ln -sf "${MINIOS_WALLPAPER}" "${PKG_DIR}/contents/images/${GEOMETRY}.${EXT}"
    ln -sf "${MINIOS_WALLPAPER}" "${PKG_DIR}/contents/screenshot.${EXT}"

    cat <<'METADATA' >"${PKG_DIR}/metadata.json"
{
    "KPlugin": {
        "Authors": [ { "Name": "MiniOS" } ],
        "Id": "MiniOS",
        "License": "CC-BY-SA-4.0",
        "Name": "MiniOS"
    }
}
METADATA

    FOUND=0
    for DEFAULTS in /usr/share/plasma/look-and-feel/org.kde.breeze*.desktop/contents/defaults; do
        [ -f "${DEFAULTS}" ] || continue
        sed -i '/^\[Wallpaper\]/,/^\[/ s/^Image=.*/Image=MiniOS/' "${DEFAULTS}"
        FOUND=1
    done
    if [ "${FOUND}" = 1 ]; then
        echo "Wallpaper default set to ${MINIOS_WALLPAPER} (wallpaper package MiniOS)"
    else
        echo "Warning: no Breeze look-and-feel defaults found; wallpaper left at package default." >&2
    fi
else
    echo "Warning: no MiniOS wallpaper found in /usr/share/backgrounds." >&2
fi

# ---------------------------------------------------------------------------
# Panel: application launcher (Kickoff) button and pinned favourites.
#
# plasmashell builds a user's first panel from the look-and-feel package's
# layout script, and both Breeze and Breeze Dark just
# loadTemplate("org.kde.plasma.desktop.defaultPanel").  Kickoff's own
# settings live in the per-user appletsrc, which only exists after that first
# start, so the one place a system-wide default can be expressed is the
# template itself: keep the addWidget() handle and write the applet's config
# before it is ever instantiated.
#
#   icon       Kickoff's compact representation is a Kirigami.Icon, which
#              takes a file path as readily as a theme name, so the same
#              MiniOS logo the XFCE Whisker button uses is reused here.
#   favorites  Kickoff ports this list into KActivities on first run and
#              never reads it again (favoritesPortedToKAstats).  Upstream's
#              default is browser, Kontact, System Settings, Dolphin and
#              Discover; the last four are either not installed here or
#              duplicated by MiniOS tools, so the list is replaced with what
#              this image actually ships -- MiniOS Store in place of any
#              software-centre or help entry.
#   launchers  The task manager's default pins are Discover, file manager and
#              browser; Discover is not installed, so it renders as a blank
#              icon.  Modules stacked on top of this one (10-apx) append their
#              own entry to this line, so keep it on one line ending in ")".
# ---------------------------------------------------------------------------
LAYOUT_JS=/usr/share/plasma/layout-templates/org.kde.plasma.desktop.defaultPanel/contents/layout.js
if [ -f "${LAYOUT_JS}" ] && grep -q '^panel.addWidget("org.kde.plasma.kickoff")$' "${LAYOUT_JS}" &&
    grep -q '^panel.addWidget("org.kde.plasma.icontasks")$' "${LAYOUT_JS}"; then
    sed -i '/^panel.addWidget("org.kde.plasma.kickoff")$/{
r /dev/stdin
d
}' "${LAYOUT_JS}" <<'KICKOFF'
// MiniOS: launcher button and default favourites (see 04-plasma-desktop/install)
var kickoff = panel.addWidget("org.kde.plasma.kickoff")
kickoff.currentConfigGroup = ["General"]
kickoff.writeConfig("icon", "/usr/share/pixmaps/MiniOS-white.svg")
kickoff.writeConfig("favorites", "preferred://browser,org.kde.dolphin.desktop,org.kde.konsole.desktop,systemsettings.desktop,minios-store.desktop,minios-configurator.desktop,minios-installer.desktop")
KICKOFF
    sed -i '/^panel.addWidget("org.kde.plasma.icontasks")$/{
r /dev/stdin
d
}' "${LAYOUT_JS}" <<'TASKS'
// MiniOS: task manager pins (see 04-plasma-desktop/install)
var tasks = panel.addWidget("org.kde.plasma.icontasks")
tasks.currentConfigGroup = ["General"]
tasks.writeConfig("launchers", "preferred://filemanager,preferred://browser")
TASKS
    echo "Kickoff and task manager defaults written into ${LAYOUT_JS}"
else
    echo "Warning: default panel layout template not found or changed; panel left at package defaults." >&2
fi

# ---------------------------------------------------------------------------
# Icons that the MiniOS tools request but Breeze does not provide.  Breeze's
# fallback chain ends in hicolor, so anything placed there is found by every
# Breeze variant without touching the icon theme setting.
#
#   isomaster        minios-image-builder; the elementary-minios theme from
#                    03-gui-base carries a proper application icon for it.
#   office-database  minios-module-manager; no theme in the image has it as
#                    an app icon, so the launcher entry is pointed at Breeze's
#                    puzzle-piece "preferences-plugin" icon (the only such icon Breeze
#                    ships at 32px and above), the closest fit for "modules".
# ---------------------------------------------------------------------------
ELEMENTARY_ICONS=/usr/share/icons/elementary-minios/apps/48
if [ -f "${ELEMENTARY_ICONS}/isomaster.svg" ]; then
    mkdir -p /usr/share/icons/hicolor/scalable/apps
    ln -sf "${ELEMENTARY_ICONS}/isomaster.svg" /usr/share/icons/hicolor/scalable/apps/isomaster.svg
fi
if [ -f /usr/share/applications/minios-module-manager.desktop ]; then
    sed -i 's/^Icon=office-database$/Icon=preferences-plugin/' /usr/share/applications/minios-module-manager.desktop
fi
gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true

# ---------------------------------------------------------------------------
# MiniOS Installer menu entry.
#
# minios-installer's own desktop file carries "NotShowIn=KDE;", so Plasma hides
# it and the live system has no "Install MiniOS" entry at all (XFCE shows it
# because it is not KDE).  The installer is a plain GTK application that runs
# fine here, so drop the exclusion.  Its icon, usb-creator-gtk, is not in
# Breeze; the elementary-minios theme carries a dedicated installer icon, so
# point the entry at that via hicolor like the other MiniOS tools above.
# ---------------------------------------------------------------------------
INSTALLER_DESKTOP=/usr/share/applications/minios-installer.desktop
if [ -f "${INSTALLER_DESKTOP}" ]; then
    sed -i '/^NotShowIn=KDE;\?$/d' "${INSTALLER_DESKTOP}"
    if [ -f "${ELEMENTARY_ICONS}/minios-installer.svg" ]; then
        mkdir -p /usr/share/icons/hicolor/scalable/apps
        ln -sf "${ELEMENTARY_ICONS}/minios-installer.svg" /usr/share/icons/hicolor/scalable/apps/minios-installer.svg
        sed -i 's/^Icon=usb-creator-gtk$/Icon=minios-installer/' "${INSTALLER_DESKTOP}"
        gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
    fi
    echo "MiniOS Installer menu entry enabled for Plasma"
fi

if [ -f /usr/share/applications/yad-icon-browser.desktop ]; then
    rm -f /usr/share/applications/yad-icon-browser.desktop
fi
