#!/bin/bash

: ${BUILD_SCRIPTS:="linux-live"}

export PATH=.:./tools:../tools:/usr/sbin:/usr/bin:/sbin:/bin:/

. /minioslib || exit 1
. /minios_build.conf || exit 1
KERNEL="${KERNEL:-$(file /boot/vmlinuz-* | grep -oP 'version \K[^\s]+')}"

console_colors

# Determine which initramfs builder to use
INITRAMFS_BUILDER="${INITRAMFS_BUILDER:-dracut}"
INITRAMFS_CRYPT="${INITRAMFS_CRYPT:-false}"
CRYPT_ARGS=()
[ "$INITRAMFS_CRYPT" = "true" ] && CRYPT_ARGS=(--crypt)

case "$INITRAMFS_BUILDER" in
dracut)
    # Build initramfs using dracut
    if [ "${VERBOSITY_LEVEL}" -ge 2 ]; then
        echo -e "   ${YELLOW}KERNEL=${KERNEL}${ENDCOLOR}"
        echo -e "   ${YELLOW}INITRAMFS_BUILDER=dracut${ENDCOLOR}"
    fi

    # Debian moved switch_root out of util-linux and into util-linux-extra
    # after trixie (trixie: /usr/sbin/switch_root in util-linux; forky:
    # /usr/bin/switch_root in util-linux-extra).  util-linux only Recommends
    # util-linux-extra, and MiniOS sets APT::Install-Recommends "0", so it is
    # absent and dracut aborts with "Failed to install switch_root".
    #
    # dracut embeds switch_root into the initramfs, so it is only needed while
    # the image is being assembled -- installing it here keeps it out of the
    # shipped system.  This overlay layer is discarded after /boot is extracted.
    if ! command -v switch_root >/dev/null 2>&1; then
        echo "I: switch_root not found; installing util-linux-extra for the initramfs build"
        export DEBIAN_FRONTEND=noninteractive
        # Module cleanup strips /var/lib/apt/lists, so refresh the index first;
        # without it apt cannot resolve the package name at all.
        apt-get update -qq || echo "W: apt-get update failed" >&2
        if apt-get install -y --no-install-recommends util-linux-extra; then
            echo "I: switch_root now at: $(command -v switch_root || echo STILL-MISSING)"
        else
            echo "W: could not install util-linux-extra; dracut will fail" >&2
        fi
    fi

    cd /$BUILD_SCRIPTS/initramfs/dracut-mos
    chmod 755 ./mkdracut

    # Build initramfs with mkdracut
    if [ "${PACKAGE_VARIANT}" = "minimum" ]; then
        run_with_spinner "Building dracut initramfs image" ./mkdracut -k "$KERNEL" "${CRYPT_ARGS[@]}"
    else
        run_with_spinner "Building dracut initramfs image" ./mkdracut -k "$KERNEL" -n -c "${CRYPT_ARGS[@]}"
    fi

    # Check if initramfs was created successfully
    if [ ! -f /boot/initrfs.img ]; then
        echo "E: Failed to create initramfs" >&2
        exit 1
    fi
    ;;

livekit | *)
    # Build initramfs using livekit (default)
    if [ "${VERBOSITY_LEVEL}" -ge 2 ]; then
        echo -e "   ${YELLOW}KERNEL=${KERNEL}${ENDCOLOR}"
        echo -e "   ${YELLOW}INITRAMFS_BUILDER=livekit${ENDCOLOR}"
    fi

    cd /$BUILD_SCRIPTS/initramfs/livekit-mos
    chmod 755 ./mkinitrfs

    TMPFILE=$(mktemp)
    if [ "${PACKAGE_VARIANT}" = "minimum" ]; then
        run_with_spinner "Building initramfs image" ./mkinitrfs -k "$KERNEL" -dm "${CRYPT_ARGS[@]}" >"$TMPFILE"
    else
        run_with_spinner "Building initramfs image" ./mkinitrfs -k "$KERNEL" -n -c -dm "${CRYPT_ARGS[@]}" >"$TMPFILE"
    fi

    INITRAMFS=$(tail -n 1 "$TMPFILE" | xargs)
    rm "$TMPFILE"

    if [ -n "$INITRAMFS" ]; then
        mv "$INITRAMFS" /boot/initrfs.img
    fi
    ;;
esac
